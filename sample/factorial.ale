'pragmat'title="factorial".
$ On the JS target, 12! fits in a signed word and 13! wraps.
'f'factorial+>n+m>:
   n<=0,1->m;
   decr+n,factorial+n+m,addmult+m+n+m+m. $ (n+1)*n! after decr
'a'intro:
   printf+"Type a number between 0 and 15, I try to compute its factorial%n".
'root'intro,(nxt-n-m:
         get int+STDIN+n,n>=0,n<=15,
         factorial+n+m,printf+"%d!=%d%n"+n+m,:nxt).
'end'

