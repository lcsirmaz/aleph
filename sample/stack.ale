'pragmat'title="a stack".
$ store integers in a stack and print them in reverse order.
'stack'[1]ST[].
'a'push+>x: (* x->ST *)ST.
'p'pop+x>: >>ST>=<<ST,ST->x,unstack+ST.

'a'read-b: get int+STDIN+b,push+b,:read;+.
'a'print-b: pop+b,print int+b,:print;+.

'root'printf+"Enter integers, then Ctrl+D or a non-number.%n"
             "They will be printed in reverse order.%n",
      read,print.
'end'
