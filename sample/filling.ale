'pragmat'title="table filling".
$ A filling gives the initial content of a list. T has three fields
$ (a,b,c), so each block of T is three words long. The program prints
$ every word of T with its address and marks the labels p1 ... p7.
$ Addresses are virtual: they start at 2^24+1 = 16777217 here, and
$ only their differences matter.
$ A block is identified by the address of its LAST word, so a label
$ ':p1' gets the address of the last word of the block before it.
'constant'four times = 4.
'table'(a,b,c)T[] = (
  $ fields set by name; '83->c->b' stores 83 in both c and b;
  $ '*2' repeats the block, p1 marks the last work in the second copy
  (81->a,83->c->b)*2:p1,
  $ values in field order a,b,c
  (204,205,206):p2,
  $ fields in any order; ca, cb, cc are defined only further down
  (cb->b,cc->c,ca->a):p3,
  $ '400->*' fills every field not named, here a and b
  (301->c,400->*):p4,
  $ a string becomes a string block; its last word, at p5, holds
  $ the width of the block (3 words for "A")
  "A":p5,
  $ only two values for three fields: the compiler warns, and the
  $ four copies take 8 words, not 12
  (73,74)*four times:p6,
  $ labels are constants, so they can be stored as values
  (p1,p2,p3):p7,
  $ a single value is a one-word block, no warning
  p7 ).
'constant'ca=100,cb=ca+1,cc=cb+1.

'a'print ptr+>i:
  =i=
  [p1],printf+" p1";
  [p2],printf+" p2";
  [p3],printf+" p3";
  [p4],printf+" p4";
  [p5],printf+" p5";
  [p6],printf+" p6";
  [p7],printf+" p7";
  +.

$ c is the last field in a block, so c*T[i] is the word at address i itself
'root'-i:
  subtr+<<T+<>T+i,(nxt:i>=>>T;
    incr+i,print int+i,print int+c*T[i],print ptr+i,print char+newline,:nxt).
'end'
