'pragmat'module=outlib,title="output rules".
$ Short names for printing to STDOUT, and an initialization which
$ only reports that it has run.

'a'c arr+t[],c int+>n,c char+>c,c str+t[]+>ptr.

'pragmat'if=compile. $ the module body
'a'c arr+t[]: put line+STDOUT+t+newline.
'a'c int+>n:  printf+"%d"+n.
'a'c char+>c: put char+STDOUT+c.
'a'c str+t[]+>p: put string+STDOUT+t+p.

$ the initialization of this module
'root'c str+"outlib: initialization",c char+newline.
'pragmat'endif=compile.
'end'
